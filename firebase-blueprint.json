{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile for freelancer or client",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User ID matching auth UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User's full name or display name"
        },
        "role": {
          "type": "string",
          "enum": ["freelancer", "client"],
          "description": "User role in ClientVault"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Profile update timestamp"
        }
      },
      "required": ["id", "email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "ClientRecord": {
      "title": "ClientRecord",
      "description": "Client profile created by the freelancer to organize files",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique client ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner freelancer UID"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Client name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Client contact email"
        },
        "company": {
          "type": "string",
          "maxLength": 100,
          "description": "Client company name"
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived"],
          "description": "Client portal status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Client creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["id", "userId", "name", "email", "status", "createdAt", "updatedAt"]
    },
    "VaultFile": {
      "title": "VaultFile",
      "description": "File record securely uploaded and managed in ClientVault",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique file ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner UID who owns this file space"
        },
        "name": {
          "type": "string",
          "maxLength": 255,
          "description": "Original file name"
        },
        "size": {
          "type": "number",
          "description": "File size in bytes"
        },
        "type": {
          "type": "string",
          "maxLength": 100,
          "description": "MIME type of the file"
        },
        "category": {
          "type": "string",
          "enum": ["design", "document", "asset", "contract", "feedback", "other"],
          "description": "File category tag"
        },
        "clientName": {
          "type": "string",
          "maxLength": 100,
          "description": "Associated client name or project"
        },
        "uploadedBy": {
          "type": "string",
          "maxLength": 100,
          "description": "Name or email of uploader"
        },
        "uploadedByRole": {
          "type": "string",
          "enum": ["freelancer", "client"],
          "description": "Role of uploader"
        },
        "downloadCount": {
          "type": "number",
          "description": "Number of times downloaded"
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional notes or instructions for this file"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Upload timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last modification timestamp"
        }
      },
      "required": ["id", "userId", "name", "size", "type", "category", "uploadedBy", "uploadedByRole", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents keyed by Auth UID"
    },
    "/clients/{clientId}": {
      "schema": "ClientRecord",
      "description": "Client records owned by a freelancer user"
    },
    "/files/{fileId}": {
      "schema": "VaultFile",
      "description": "Secure file metadata records owned and managed by users"
    }
  }
}
