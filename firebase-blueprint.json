{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile for Keepsake",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User ID matching Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 150,
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name"
        },
        "starterSeeded": {
          "type": "boolean",
          "description": "Whether the starter journal entry was created for this user"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last profile update timestamp"
        }
      },
      "required": ["id", "email", "displayName", "createdAt", "updatedAt"]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "A user's private daily diary and personal reflection entry",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique journal entry ID"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner UID matching parent user document"
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Entry calendar date in YYYY-MM-DD format"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "Short entry title"
        },
        "mood": {
          "type": "string",
          "enum": ["Happy", "Productive", "Stressed", "Chill", "Grateful", "Sad"],
          "description": "Mood tag for the day"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "description": "Journal entry body text"
        },
        "isFavorite": {
          "type": "boolean",
          "description": "Whether the entry is starred as a favorite"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when entry was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when entry was last edited"
        }
      },
      "required": ["id", "userId", "date", "title", "mood", "content", "createdAt", "updatedAt"]
    },
    "Deadline": {
      "title": "Deadline",
      "description": "A student project or assignment deadline stored under a user's account",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique deadline ID"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner UID matching parent user document"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "Project or assignment title"
        },
        "subject": {
          "type": "string",
          "maxLength": 100,
          "description": "Optional course or subject name"
        },
        "dueDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Due date in YYYY-MM-DD format"
        },
        "notes": {
          "type": "string",
          "maxLength": 2000,
          "description": "Optional requirements or reminders"
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the deadline has been marked done"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when deadline was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when deadline was last updated"
        }
      },
      "required": ["id", "userId", "title", "dueDate", "completed", "createdAt", "updatedAt"]
    },
    "ScheduleBlock": {
      "title": "ScheduleBlock",
      "description": "A weekly class or study timetable block stored under a user's account",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique schedule block ID"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner UID matching parent user document"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "Class or study session title"
        },
        "category": {
          "type": "string",
          "enum": ["Class", "Study"],
          "description": "Whether the block is a class or study session"
        },
        "dayOfWeek": {
          "type": "string",
          "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "description": "Day of the week for this recurring timetable block"
        },
        "startTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[0-2][0-9]:[0-5][0-9]$",
          "description": "Start time in 24-hour HH:MM format"
        },
        "endTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[0-2][0-9]:[0-5][0-9]$",
          "description": "End time in 24-hour HH:MM format"
        },
        "location": {
          "type": "string",
          "maxLength": 100,
          "description": "Optional classroom, building, or study location"
        },
        "color": {
          "type": "string",
          "enum": ["#D8A7B1", "#FBC4AB", "#FADADD", "#F8C8DC", "#BC8F8F"],
          "description": "Soft pastel color code for the schedule block"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when block was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when block was last updated"
        }
      },
      "required": ["id", "userId", "title", "category", "dayOfWeek", "startTime", "endTime", "color", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profile documents keyed by Auth UID"
    },
    "/users/{userId}/entries/{entryId}": {
      "schema": "JournalEntry",
      "description": "Private daily journal entries stored under each user's account"
    },
    "/users/{userId}/deadlines/{deadlineId}": {
      "schema": "Deadline",
      "description": "Private student assignment and project deadlines stored under each user's account"
    },
    "/users/{userId}/schedule/{blockId}": {
      "schema": "ScheduleBlock",
      "description": "Private weekly class and study schedule blocks stored under each user's account"
    }
  }
}
