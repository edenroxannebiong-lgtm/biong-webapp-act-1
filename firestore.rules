rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation for User Profile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 150 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['freelancer', 'client'] &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // Validation for Client Record
    function isValidClientRecord(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'email', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'userId', 'name', 'email', 'company', 'status', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             (!('company' in data) || (data.company is string && data.company.size() <= 100)) &&
             data.status in ['active', 'archived'] &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // Validation for Vault File
    function isValidVaultFile(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'size', 'type', 'category', 'uploadedBy', 'uploadedByRole', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'userId', 'name', 'size', 'type', 'category', 'clientName', 'uploadedBy', 'uploadedByRole', 'downloadCount', 'notes', 'previewUrl', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 255 &&
             data.size is number && data.size >= 0 &&
             data.type is string && data.type.size() <= 100 &&
             data.category in ['design', 'document', 'asset', 'contract', 'feedback', 'other'] &&
             (!('clientName' in data) || (data.clientName is string && data.clientName.size() <= 100)) &&
             data.uploadedBy is string && data.uploadedBy.size() <= 100 &&
             data.uploadedByRole in ['freelancer', 'client'] &&
             (!('downloadCount' in data) || (data.downloadCount is number && data.downloadCount >= 0)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             (!('previewUrl' in data) || (data.previewUrl is string && data.previewUrl.size() <= 2000)) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Blanket user listing forbidden for PII security

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().id == userId &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'updatedAt']);

      allow delete: if false; // User accounts cannot be deleted directly via client SDK
    }

    // Client Record Rules
    match /clients/{clientId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(clientId) &&
                       isValidClientRecord(incoming()) &&
                       incoming().id == clientId &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
                       isValidId(clientId) &&
                       isValidClientRecord(incoming()) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'company', 'status', 'updatedAt']);

      allow delete: if isSignedIn() &&
                       isValidId(clientId) &&
                       existing().userId == request.auth.uid;
    }

    // Vault Files Rules
    match /files/{fileId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(fileId) &&
                       isValidVaultFile(incoming()) &&
                       incoming().id == fileId &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
                       isValidId(fileId) &&
                       isValidVaultFile(incoming()) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'clientName', 'downloadCount', 'notes', 'previewUrl', 'updatedAt']);

      allow delete: if isSignedIn() &&
                       isValidId(fileId) &&
                       existing().userId == request.auth.uid;
    }
  }
}
