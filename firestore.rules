rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Helper: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'email', 'displayName', 'starterSeeded', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 150 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (!('starterSeeded' in data) || data.starterSeeded is bool) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // Validation Helper: JournalEntry
    function isValidJournalEntry(data) {
      return data.keys().hasAll(['id', 'userId', 'date', 'title', 'mood', 'content', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'userId', 'date', 'title', 'mood', 'content', 'isFavorite', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.mood in ['Happy', 'Productive', 'Stressed', 'Chill', 'Grateful', 'Sad'] &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 10000 &&
             (!('isFavorite' in data) || data.isFavorite is bool) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // Validation Helper: Deadline
    function isValidDeadline(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'dueDate', 'completed', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'userId', 'title', 'subject', 'dueDate', 'notes', 'completed', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             (!('subject' in data) || (data.subject is string && data.subject.size() <= 100)) &&
             data.dueDate is string && data.dueDate.size() == 10 && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
             data.completed is bool &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // Validation Helper: ScheduleBlock
    function isValidScheduleBlock(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'category', 'dayOfWeek', 'startTime', 'endTime', 'color', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'userId', 'title', 'category', 'dayOfWeek', 'startTime', 'endTime', 'location', 'color', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.category in ['Class', 'Study'] &&
             data.dayOfWeek in ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'] &&
             data.startTime is string && data.startTime.size() == 5 && data.startTime.matches('^[0-2][0-9]:[0-5][0-9]$') &&
             data.endTime is string && data.endTime.size() == 5 && data.endTime.matches('^[0-2][0-9]:[0-5][0-9]$') &&
             (!('location' in data) || (data.location is string && data.location.size() <= 100)) &&
             data.color in ['#D8A7B1', '#FBC4AB', '#FADADD', '#F8C8DC', '#BC8F8F'] &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // User Profiles Collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Blanket user listing forbidden for PII security

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().id == userId &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().email == existing().email &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'starterSeeded', 'updatedAt']);

      allow delete: if false;

      // Private Daily Journal Entries Subcollection
      match /entries/{entryId} {
        allow get: if isOwner(userId) &&
                      isValidId(userId) &&
                      isValidId(entryId) &&
                      existing().userId == userId;

        allow list: if isOwner(userId) &&
                       resource.data.userId == request.auth.uid;

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(entryId) &&
                         isValidJournalEntry(incoming()) &&
                         incoming().id == entryId &&
                         incoming().userId == userId &&
                         incoming().createdAt == request.time &&
                         incoming().updatedAt == request.time;

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(entryId) &&
                         isValidJournalEntry(incoming()) &&
                         existing().userId == userId &&
                         incoming().userId == existing().userId &&
                         incoming().id == existing().id &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['date', 'title', 'mood', 'content', 'isFavorite', 'updatedAt']);

        allow delete: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(entryId) &&
                         existing().userId == userId;
      }

      // Private Student Deadlines Subcollection
      match /deadlines/{deadlineId} {
        allow get: if isOwner(userId) &&
                      isValidId(userId) &&
                      isValidId(deadlineId) &&
                      existing().userId == userId;

        allow list: if isOwner(userId) &&
                       resource.data.userId == request.auth.uid;

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(deadlineId) &&
                         isValidDeadline(incoming()) &&
                         incoming().id == deadlineId &&
                         incoming().userId == userId &&
                         incoming().createdAt == request.time &&
                         incoming().updatedAt == request.time;

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(deadlineId) &&
                         isValidDeadline(incoming()) &&
                         existing().userId == userId &&
                         incoming().userId == existing().userId &&
                         incoming().id == existing().id &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'subject', 'dueDate', 'notes', 'completed', 'updatedAt']);

        allow delete: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(deadlineId) &&
                         existing().userId == userId;
      }

      // Private Weekly Schedule Blocks Subcollection
      match /schedule/{blockId} {
        allow get: if isOwner(userId) &&
                      isValidId(userId) &&
                      isValidId(blockId) &&
                      existing().userId == userId;

        allow list: if isOwner(userId) &&
                       resource.data.userId == request.auth.uid;

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(blockId) &&
                         isValidScheduleBlock(incoming()) &&
                         incoming().id == blockId &&
                         incoming().userId == userId &&
                         incoming().createdAt == request.time &&
                         incoming().updatedAt == request.time;

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(blockId) &&
                         isValidScheduleBlock(incoming()) &&
                         existing().userId == userId &&
                         incoming().userId == existing().userId &&
                         incoming().id == existing().id &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'dayOfWeek', 'startTime', 'endTime', 'location', 'color', 'updatedAt']);

        allow delete: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(blockId) &&
                         existing().userId == userId;
      }
    }
  }
}
